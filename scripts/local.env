# Local filesystem "bucket" standing in for the GCS bucket mount that
# Cloud Run gets in production. Every stage treats GCS_BUCKET_PATH as
# an ordinary filesystem path (see e.g. integration/src/integrate.py),
# so pointing it at a local directory is enough to run the real
# pipeline code with no GCP access at all.
#
# Usage: source scripts/local.env   (from the repo root, in bash)

REPO_ROOT_POSIX="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# On Git Bash / MSYS, any env var value that looks like a POSIX
# absolute path (e.g. "/parquet/cygnss", or a bash-native "/c/Users/...")
# gets silently rewritten when a native (non-MSYS) exe like python.exe
# is spawned. That's actively helpful for a real filesystem path (it's
# how "/c/Users/..." becomes the "C:\Users\..." python.exe needs), but
# it also mangles CYGNSS_PARQUET_PATH-style variables below, which are
# meant to stay literal path *suffixes*, not real paths on their own
# (e.g. "/parquet/cygnss" -> "C:/Program Files/Git/parquet/cygnss").
#
# Fix: convert REPO_ROOT to its native Windows form ourselves (so it
# no longer needs MSYS's rewriting), then disable that rewriting
# globally with MSYS_NO_PATHCONV so the suffix variables are left alone.
if command -v cygpath >/dev/null 2>&1; then
  export REPO_ROOT="$(cygpath -m "$REPO_ROOT_POSIX")"
else
  export REPO_ROOT="$REPO_ROOT_POSIX"
fi
export MSYS_NO_PATHCONV=1

export GCS_BUCKET_PATH="$REPO_ROOT/local_bucket"
export CYGNSS_RAW_PATH=/raw/cygnss
export SMAP_RAW_PATH=/raw/smap
export CYGNSS_PARQUET_PATH=/parquet/cygnss
export SMAP_PARQUET_PATH=/parquet/smap
export INTEGRATED_PARQUET_PATH=/parquet/integrated
export SOIL_MOISTURE_PARQUET_PATH=/parquet/soil_moisture

# How many days of synthetic historical (CYGNSS+SMAP merged) data to
# seed. Only needs to clear K_NEIGHBORS in retrieval.py, not the full
# 30-day production window -- retrieval.py already tolerates missing
# days in the window.
export SEED_HISTORY_DAYS=5
